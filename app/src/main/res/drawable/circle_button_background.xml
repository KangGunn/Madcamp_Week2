<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 원형 배경 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#88CCCCCC" /> <!-- 반투명 회색 -->
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>

    <!-- 돋보기 이미지 -->
    <item
        android:drawable="@drawable/magnifying_glass"
        android:gravity="center" />
</layer-list>
